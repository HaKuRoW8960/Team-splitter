# Discord Bot トークン (Discord Developer Portal -> Bot -> Reset Token で取得)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID / Client ID (Discord Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=your_discord_client_id_here

# (任意) 特定のサーバー(Guild)に即座にスラッシュコマンドを反映させたい場合はサーバーIDを入力
# 空欄の場合はグローバルコマンドとして全サーバーに登録されます
DISCORD_GUILD_ID=

# Web UI サーバーのポート番号
PORT=3000

# Botの「🌐 Web UIを開く」ボタンに設定されるURL (ローカルなら http://localhost:3000)
PUBLIC_URL=http://localhost:3000
